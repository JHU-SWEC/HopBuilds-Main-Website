# Copy to server/.env and fill in real values. Never commit server/.env.

# From MongoDB Atlas: Connect > Drivers. Replace <db_password> with the real
# password, and URL-encode it if it contains characters like @ : / ? # [ ] %
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?appName=Cluster0

MONGODB_DB=hopbuilds
MONGODB_COLLECTION=arcade_scores

PORT=3001

# Comma-separated origins allowed to call the API. Leave empty to allow all
# (fine for local dev). Set this in production.
ALLOWED_ORIGINS=http://localhost:8000,https://jhu-swec.github.io
