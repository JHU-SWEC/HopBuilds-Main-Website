# Copy to .env.local and fill in real values. Never commit the filled-in copy.
# In production these are set in the Vercel dashboard, not in a file.

# From MongoDB Atlas: Connect > Drivers. Replace the password placeholder with
# the real password, URL-encoded if it contains characters like @ : / ? # [ ] %
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?appName=Cluster0

MONGODB_DB=hopbuilds
MONGODB_COLLECTION=arcade_scores
