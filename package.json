{
  "name": "hopbuilds-main-website",
  "version": "1.0.0",
  "private": true,
  "description": "HopBuilds homepage plus the serverless leaderboard API for the speed-math bonus round.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:vercel": "vercel dev",
    "build": "vite build",
    "preview": "vite preview",
    "export-emails": "node scripts/export-emails.js",
    "dedupe-scores": "node scripts/dedupe-scores.js",
    "test-leaderboard:serve": "MONGODB_COLLECTION=arcade_scores_test MONGODB_SESSION_COLLECTION=arcade_sessions_test MONGODB_RATE_LIMIT_COLLECTION=arcade_rate_limits_test vite --port 8001",
    "test-leaderboard": "MONGODB_COLLECTION=arcade_scores_test MONGODB_SESSION_COLLECTION=arcade_sessions_test MONGODB_RATE_LIMIT_COLLECTION=arcade_rate_limits_test node scripts/test-leaderboard.js"
  },
  "dependencies": {
    "gsap": "3.12.5",
    "lenis": "1.1.14",
    "mongodb": "^6.8.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "vite": "^8.2.2"
  }
}
